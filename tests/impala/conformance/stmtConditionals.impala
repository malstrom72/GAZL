/*
	Conformance: Impala.md#conditionals
	`if` / `else if` / `else`, with and without blocks.
	Expected (GAZLCmd stmtConditionals.gazl main): 1 -1 0
*/
const int DEBUG = 1
extern native printInt
extern native printFloat
extern native printLF

function sign(int x) returns int r
{
	if (x > 0)
		r = 1;
	else if (x < 0)
		r = -1;
	else {
		r = 0;
	}
}

function main()
{
	printInt(sign(5)); printLF();
	printInt(sign(-5)); printLF();
	printInt(sign(0)); printLF();
}

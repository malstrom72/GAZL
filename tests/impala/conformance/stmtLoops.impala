/*
	Conformance: Impala.md#loops
	`for` stops before its bound and may reuse the variable; `while`, `do...while`, and `loop` left with `goto`.
	Expected (GAZLCmd stmtLoops.gazl main): 10 7 3 1 5
*/
const int DEBUG = 1
extern native printInt
extern native printFloat
extern native printLF

function main()
locals int i, int n
{
	n = 0;
	for (i = 0 to 5) n = n + i;
	printInt(n); printLF();
	i = 3;
	n = 0;
	for (i to 5) n = n + i;
	printInt(n); printLF();
	n = 0;
	while (n < 3) n = n + 1;
	printInt(n); printLF();
	n = 0;
	do { n = n + 1; } while (n < 0)
	printInt(n); printLF();
	n = 0;
	loop {
		if (n == 5) goto finished;
		n = n + 1;
	}
	finished: ;
	printInt(n); printLF();
}

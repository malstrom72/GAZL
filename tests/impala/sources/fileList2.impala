/*
	Prawn OS Command Prompt - ported to Impala 2.

	This is `fileList.impala` rewritten with the 2.0 type system; the 1.0 original stays in the corpus
	beside it as backward-compatibility coverage. The port is what the 2.0 features are FOR, so the two
	files are meant to be read as a diff:

	  - A four-word record hand-addressed through `FILE_FIELD_NAME`..`FILE_FIELD_COUNT` becomes a
	    `struct File`. The five consts go away, and so does every `i * FILE_FIELD_COUNT + FILE_FIELD_x`
	    - the stride is now the assembler's `.z.File` and the offset its `.o.File.name`.
	  - `FILE_NAMES[MAX_FILE_COUNT * (MAX_FILE_NAME_LENGTH + 1)]` becomes a rectangular
	    `[MAX_FILE_COUNT, MAX_FILE_NAME_LENGTH + 1]`, so a row is `&FILE_NAMES[i, 0]` instead of a
	    pointer the author has to remember to advance by the row length.
	  - The three-way swap in `sortFiles` was `copy (FILE_FIELD_COUNT from .. to ..)` through a scratch
	    array plus two saved pointers; whole-struct assignment says the same thing in three lines and
	    the word count is `.z.File`, not a const that has to be kept in step with the record.

	  - Every `pointer` is now an `int pointer` and every `array` an `int array`, which is what
	    retires the `(int)` casts on the derefs: a 1.0 `pointer` has no element type, so `*a` was
	    untyped and every read of it had to say so. `findFirmwarePatch`'s signature moved out of its
	    comment and into a checked prototype for the same reason - the `== 1` needed a cast only
	    because a name-only extern returns `unknown`.

	The built-in table's DATA rows assemble to the same words as the 1.0 version's - that equivalence is
	the point, and `tests/impala/golden/fileList2.gazl` is the record of it.

	The general form of this rewrite - and what it costs, which is nothing - is in
	docs/impala/WhatsNewInImpala2.md under "What is worth rewriting".

	Not run by the gate: `findFirmwarePatch` is a host native, so this compiles and link-checks only,
	exactly as `fileList.impala` does.
*/

/* The signature used to live in this comment; as a prototype it is checked at every call and the
   result has a real type, so the `(int)` cast on the `== 1` below is gone. Returns 1 if found, 0 if
   no more patches are available - which also means the next call refreshes the list. */
extern native findFirmwarePatch(int index, int nameMaxLength, int pointer name, int pointer size,
		int pointer modDate) returns int

const int FILE_TYPE_COUNT = 4
const int FILE_TYPE_EXE = 0
const int FILE_TYPE_SYS = 1
const int FILE_TYPE_TXT = 2
const int FILE_TYPE_BIN = 3
readonly int pointer array FILE_TYPE_STRINGS[FILE_TYPE_COUNT] = {
	"exe", "sys", "txt", "bin"
}

struct File {
	int pointer name;
	int type;
	int size;
	int pointer date
}

const int MAX_FILE_COUNT = 100
const int MAX_FILE_NAME_LENGTH = 31
const int FILE_DATE_LENGTH = 8
const int BUILT_IN_FILE_COUNT = 14
global int fileCount = BUILT_IN_FILE_COUNT

global File array FILES[MAX_FILE_COUNT] = {
	  { name: "about"	, type: FILE_TYPE_TXT	, size: 2	, date: "11/13/84" }
	, { name: "advent"	, type: FILE_TYPE_EXE	, size: 91	, date: " 2/21/78" }
	, { name: "bluprint", type: FILE_TYPE_TXT	, size: 2 	, date: " 6/ 5/79" }
	, { name: "calc"	, type: FILE_TYPE_EXE	, size: 7	, date: "11/25/77" }
	, { name: "chess"	, type: FILE_TYPE_EXE	, size: 16	, date: " 3/ 6/84" }
	, { name: "disasm"	, type: FILE_TYPE_EXE	, size: 4	, date: "11/25/77" }
	, { name: "fredrik"	, type: FILE_TYPE_TXT	, size: 5	, date: " 7/14/84" }
	, { name: "life"	, type: FILE_TYPE_EXE	, size: 5	, date: " 3/12/79" }
	, { name: "magnus"	, type: FILE_TYPE_TXT	, size: 5	, date: " 6/22/84" }
	, { name: "patch"	, type: FILE_TYPE_EXE	, size: 3  	, date: " 2/18/84" }
	, { name: "permut8"	, type: FILE_TYPE_SYS	, size: 82	, date: " 3/ 1/83" }
	, { name: "prawnos"	, type: FILE_TYPE_SYS	, size: 58	, date: "10/11/84" }
	, { name: "readme"	, type: FILE_TYPE_TXT	, size: 2	, date: "12/14/79" }
	, { name: "version"	, type: FILE_TYPE_TXT	, size: 1	, date: "11/13/84" }
};
global int array FILE_NAMES[MAX_FILE_COUNT, MAX_FILE_NAME_LENGTH + 1];
global int array FILE_DATES[MAX_FILE_COUNT, FILE_DATE_LENGTH + 1];

global int filesAreInited = 0;

function strcmp(int pointer s0, int pointer s1)
returns int d
locals int pointer a, int pointer b, int c
{
	a = s0;
	b = s1;
	while ((d = (c = *a) - *b) == 0 && c != 0) {
		a = a + 1;
		b = b + 1;
	}
}

function sortFiles()
locals int i, int j, int minJ, int pointer minS, int pointer s, File temp
{
	for (i = 0 to global fileCount - 1) {
		minJ = i;
		minS = global FILES[i].name;
		for (j = i + 1 to global fileCount) {
			if (strcmp((s = global FILES[j].name), minS) < 0) {
				minJ = j;
				minS = s;
			}
		}
		temp = global FILES[minJ];
		global FILES[minJ] = global FILES[i];
		global FILES[i] = temp;
	}
}

function initFilesIfNecessary()
locals int index, int size, File pointer filePointer, int pointer namePointer,
		int pointer datePointer
{
	if (global filesAreInited == 0) {
		assert(global fileCount == BUILT_IN_FILE_COUNT);
		index = 0;
		filePointer = &global FILES[BUILT_IN_FILE_COUNT];
		namePointer = &global FILE_NAMES[0, 0];
		datePointer = &global FILE_DATES[0, 0];
		while (findFirmwarePatch(index, MAX_FILE_NAME_LENGTH, namePointer, &size, datePointer) == 1) {
			if (index < MAX_FILE_COUNT) {
				filePointer->name = namePointer;
				filePointer->type = FILE_TYPE_BIN;
				filePointer->size = (size + 1023) / 1024;
				filePointer->date = datePointer;
				index = index + 1;
				/* A struct pointer moves by scaled subscript, never by `+ 1` (that is E307), so one
				   record on is `&p[1]` and the stride is `.z.File`. The row pointers name a row
				   instead of adding a row length the author had to keep in step with the extent. */
				filePointer = &filePointer[1];
				namePointer = &global FILE_NAMES[index, 0];
				datePointer = &global FILE_DATES[index, 0];
				/* Strict `<`, exactly as the 1.0 original has it: the loop keeps calling
				   findFirmwarePatch after the table is full - it has to, or the list never refreshes -
				   and it hands over whatever these still point at. So the moment one becomes a
				   one-past-the-end address is the moment the next call would write past the array. */
				assert(filePointer < &global FILES[MAX_FILE_COUNT]);
				assert(namePointer < &global FILE_NAMES[MAX_FILE_COUNT, 0]);
				assert(datePointer < &global FILE_DATES[MAX_FILE_COUNT, 0]);
			}
		}
		global fileCount = BUILT_IN_FILE_COUNT + index;

		sortFiles();

		global filesAreInited = 1;
	}
}

function findFile(int pointer s0)
returns int file
{
	initFilesIfNecessary();
	for (file = 0 to global fileCount)
		if (strcmp(s0, global FILES[file].name) == 0) goto found;
	file = -1;
found: ;
}

function lower(int pointer s)
locals int pointer p, int c
{
	p = s;
	while ((c = *p) != 0) {
		if (c >= 'A' && c <= 'Z') *p = c + ('a' - 'A');
		p = p + 1;
	}
}

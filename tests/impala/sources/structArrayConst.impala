/*
	Constant struct-array index folds to a single compile-time offset: v.filters[2].b0 becomes
	one PEEK/POKE with the whole offset (.o.Voice.filters + 2*sizeof(Biquad) + .o.Biquad.b0) built
	by assemble-time ! ADDi - no runtime ADDp. A dynamic index still materializes (inherent).

	Expected (GAZLCmd structArrayConst.gazl main): 0.5 1.5 0.25 3
*/
const int DEBUG = 1
struct Biquad { float b0; float z1 }
struct Voice  { int note; Biquad array filters[3]; float gain }
extern native printFloat
extern native printLF

function sumB0(Voice pointer v) returns float s
locals int i
{
	s = 0.0;
	for (i = 0 to 3) s = s + v->filters[i].b0;		// dynamic index (materializes)
}

function main()
locals Voice v
{
	v.filters[2].b0 = 0.5;							// constant index, local place -> folded offset
	v.filters[2].z1 = 1.5;
	v.filters[0].b0 = 0.25;
	v.filters[1].b0 = 2.25;
	printFloat(v.filters[2].b0); printLF();			// 0.5
	printFloat(v.filters[2].z1); printLF();			// 1.5
	printFloat(v.filters[0].b0); printLF();			// 0.25
	printFloat(sumB0(&v)); printLF();				// 0.25+2.25+0.5 = 3.0
}

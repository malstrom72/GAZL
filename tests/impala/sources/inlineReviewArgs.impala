/*
	REVIEW 1/5 - the per-argument decision (docs/Inlining.md section 5).

	Every call passes exactly one argument, so the marshalling for it is unambiguous in the
	listing. The question to check at each call site is whether the `MOV` that filled the call
	window slot SURVIVED (materialised) or was DELETED and its source used directly
	(substituted). A substituted call should show the body's arithmetic reading `$w` / `<A>`
	straight off, with no window slot in sight.

	  1 local + transparent body   -> SUBSTITUTE   (the whole point of the feature)
	  2 literal + transparent body -> materialise  (only a SLOT may be substituted)
	  3 global + transparent body  -> materialise  (a global is a PEEK, not a slot)
	  4 computed + transparent     -> materialise  (already in the slot, nothing to delete)
	  5 local + OPAQUE body        -> materialise  (the body writes through a pointer, so it
	                                                could observe the argument's own storage)

	Expected (GAZLCmd inlineReviewArgs.gazl main): 30 60 90 120 21
*/
const int DEBUG = 1

extern native printInt
extern native printLF

global int g;

inline function triple(int a) returns int r { r = a * 3; }

inline function viaPtr(int pointer p, int a) returns int r
{
	*p = 1;						/* POKE to a pointer VALUE -> this body is OPAQUE */
	r = a * 3;
}

function main()
locals int w, int array cell[1]
{
	w = 10;
	printInt(triple(w)); printLF();				/* 30  - case 1: substituted */
	printInt(triple(20)); printLF();			/* 60  - case 2: literal, materialised */

	global g = 30;
	printInt(triple(global g)); printLF();		/* 90  - case 3: global, materialised */
	printInt(triple(w + 30)); printLF();		/* 120 - case 4: computed, materialised */

	cell[0] = 0;
	w = 7;
	printInt(viaPtr(&cell[0], w)); printLF();	/* 21  - case 5: opaque, materialised */
}

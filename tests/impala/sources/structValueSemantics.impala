/*
	Review: by-value struct param + by-value return + whole-struct copy, plus the place-reuse
	case (*p = dst; p->a ...). Look for COPY ... *.z.V (symbolic), the PARA *N return window
	(numeric transient - the legitimate exception), and that p->a compiles after *p = dst.
	Expected (GAZLCmd structValueSemantics.gazl main): 6 1.5 106
*/
const int DEBUG = 1
struct V { int a; float b }
extern native printInt
extern native printFloat
extern native printLF
function bump(V x) returns V y { y = x; y.a = x.a + 1; }
function main()
locals V src, V dst, int array raw[4], V pointer p
{
	src.a = 5; src.b = 1.5;
	dst = bump(src);
	p = (V pointer)&raw[0]; *p = dst; p->a = p->a + 100;
	printInt(dst.a); printLF();
	printFloat(dst.b); printLF();
	printInt(p->a); printLF();
}

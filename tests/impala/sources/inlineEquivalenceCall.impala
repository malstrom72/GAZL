/*
	The CALL half of the inlining oracle: byte-for-byte `inlineEquivalence.impala` with the `inline`
	keywords removed, so it compiles to ordinary out-of-line calls. Its Expected output must match its
	twin exactly; a divergence is an inlining miscompile.

	The interesting member is `clobber`: it writes the very global it is passed. Out of line, the
	argument is copied into the call window BEFORE the body runs, so it returns the old value. An
	inliner that substituted the global would read it after the write and return the new one. So a
	divergence between these two files is exactly the aliasing bug, caught numerically rather than by
	inspecting GAZL.

	`viaPointer` makes the body opaque (it writes through a pointer), which forces even a plain local
	argument to be materialised. `pure` is transparent, so its arguments are substituted.

	Expected (GAZLCmd inlineEquivalenceCall.gazl main): 31 1 99 5 7 0 6 3 60 15 11 20 11 10 20 99
*/

const int DEBUG = 1

extern native printInt
extern native printLF

global int shared;

struct P { int x; int y }

function pure(int a, int b) returns int r { r = a * 3 + b; }

function clobber(int a) returns int r
{
	global shared = 99;
	r = a;
}

function clamp(int v, int lo, int hi) returns int r
locals int t						// a scalar local becomes a transient per expansion
{
	t = v;
	if (t < lo) { t = lo; }
	if (t > hi) { t = hi; }
	r = t;
}

function viaPointer(int pointer p, int a) returns int r
{
	*p = 7;							// opaque: destination is a pointer VALUE
	r = a;
}

function sum3(int a, int b, int c) returns int r
locals int array buf[3], int i		// an ARRAY local: a run of adjacent transients per expansion
{
	buf[0] = a; buf[1] = b; buf[2] = c;
	r = 0;
	for (i = 0 to 3) { r = r + buf[i]; }
}

function dot(int ax, int ay, int bx, int by) returns int r
locals P a, P b					// STRUCT locals: fields reach their slot via a folded %<X> index
{
	a.x = ax; a.y = ay;
	b.x = bx; b.y = by;
	r = a.x * b.x + a.y * b.y;
}

function helper(int a) returns int r { r = a * 2; }		// NOT inline: the body below calls it

function wrap(int a) returns int r { r = helper(a) + 1; }

function pick(int i) returns int r
{ switch (i == 0 to 3) { case 0: r = 10; case 1: r = 20; default: r = 99; } }

function main()
locals int t, int array cell[1]
{
	t = 10;
	printInt(pure(t, 1)); printLF();		// 31

	global shared = 1;
	printInt(clobber(global shared)); printLF();	// 1  - value from BEFORE the body
	printInt(global shared); printLF();				// 99 - the body ran

	cell[0] = 0;
	t = 5;
	printInt(viaPointer(&cell[0], t)); printLF();	// 5  - the returned parameter
	printInt(cell[0]); printLF();					// 7  - written through the pointer

	printInt(clamp(-4, 0, 6)); printLF();			// 0  - scalar local, expanded twice below
	printInt(clamp(8, 0, 6)); printLF();			// 6
	printInt(clamp(3, 0, 6)); printLF();			// 3

	printInt(sum3(10, 20, 30)); printLF();			// 60 - array local, two expansions
	printInt(sum3(sum3(1, 2, 3), 4, 5)); printLF();	// 15 - nested, so two runs are live at once

	printInt(dot(1, 2, 3, 4)); printLF();			// 11 - struct locals, symbolic field offsets
	printInt(dot(2, 2, 5, 5)); printLF();			// 20 - second expansion

	printInt(wrap(5)); printLF();					// 11 - an inlined body containing a CALL
	printInt(pick(0)); printLF();					// 10 - an inlined SWITCH
	printInt(pick(1)); printLF();					// 20
	printInt(pick(2)); printLF();					// 99 - default arm
}

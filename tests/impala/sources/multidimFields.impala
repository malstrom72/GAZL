/*
	A struct array FIELD may state a SHAPE - `int array cells[3, 4]` - and a subscript then names every
	axis: `cells[y, x]`. The field allocates the product of its axes, and each axis becomes its own
	assemble-time constant `.d.<Struct>.<field>.<k>`, numbered by STRIDE with axis 0 innermost.

	Why per-axis symbols rather than the existing `.z.`: `.z.Grid.cells` is the total in words, so a
	rank-2 shape has nothing to stride by and nothing to bounds-check an individual coordinate against.
	A flat check cannot catch `cells[0, 5]` on a `[3, 4]` - word offset 5 is comfortably inside the
	allocation of 12, and is off the end of its row. That case is exactly what a shape exists to catch,
	so every axis is checked against its own extent (E461) and row-crossing is rejected rather than
	defined. `.d.` is keyed on the STRUCT, not the object, so the extents survive a call boundary: `sum`
	below indexes safely through a `Grid pointer` and nothing had to be passed alongside it.

	Lowering is the flat form the programmer would otherwise hand-write - `y * W + x`, one MULi and one
	ADDi - and a constant subscript folds entirely at assembly time, so `cells[2, 3]` costs no more than
	a 1-D `cells[11]`. Covers: a 2-D and a 3-D field, constant and runtime indices, read and write,
	access through a pointer parameter, and a shape sharing a struct with an ordinary 1-D field.

	Expected (GAZLCmd multidimFields.gazl main): 23 138 3 210 13
*/

const int DEBUG = 0

extern native printInt
extern native printLF

struct Grid
{
	int array cells[3, 4];
	int array cube[2, 3, 4];
	int array flat[5];
	int tag
}

global Grid g

/* A shape reached through a POINTER parameter: the axes come from the struct type, so the callee
   strides and bounds-checks with nothing passed but the pointer. */
function sum(Grid pointer p, int rows) returns int total
locals int y, int x
{
	total = 0;
	for (y = 0 to rows) {
		for (x = 0 to 4) {
			total = total + p->cells[y, x];
		}
	}
}

export function main()
locals int y, int x, int z, int v
{
	for (y = 0 to 3) {
		for (x = 0 to 4) {
			global g.cells[y, x] = y * 10 + x;
		}
	}
	printInt(global g.cells[2, 3]);                 /* constant subscript, folds at assembly */
	printLF();

	printInt(sum(&global g, 3));                    /* rows 0..2: 6 + 46 + 86 = 138 */
	printLF();

	global g.cube[1, 2, 3] = 3;                     /* a 3-D field shares the same machinery */
	printInt(global g.cube[1, 2, 3]);
	printLF();

	global g.flat[4] = 210;                         /* a 1-D field in the same struct is unaffected */
	printInt(global g.flat[4]);
	printLF();

	y = 1;
	x = 3;
	v = global g.cells[y, x];                       /* runtime indices on both axes */
	printInt(v);
	printLF();
}

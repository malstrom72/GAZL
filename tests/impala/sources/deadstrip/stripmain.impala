const int DEBUG = 1
import "striplib.impala"
extern native printInt
extern native printLF

/*	Expected (GAZLCmd stripmain.gazl main): 42 9 9 0 0 0 7 5 4 3

   KEPT is initialized SHORT of its extent, so its trailing words are zero-fill and DEAD's initializer
   fits exactly in that slack - which is how a stripped DEAD used to be adopted by KEPT with no error
   anywhere. BUF_SIZE is referenced only as an array extent (`GLOB *BUF_SIZE`), the one reference shape
   the reachability scan used to miss. Neither is provable by a byte-compare against a golden, so
   importBuildTests RUNS this program and checks what it prints. */
const int BUF_SIZE = 2
readonly int array KEPT[5] = { 9, 9 }
readonly int array DEAD[3] = { 1, 2, 3 }
global int array buf[BUF_SIZE]

/* Dead-stripping an array OF A STRUCT, which nothing covered before. A struct's layout block sits
   directly above the arrays using it and ends in `.z.Voice: ! DEFi` - which since 2026-08-02 looks
   like an array's own extent line, because `.z.` names both. `deadVoices` is unreferenced on purpose;
   `liveVoice` is what proves the layout survived it, since `.z.Voice` is a dotted name that
   `collectRefs` cannot see and so nothing else would notice it disappearing.

   Honest limit: this does NOT prove the extent walk stops on the NAME rather than the tag. The
   `; signature struct ...` row between the layout and the next fold halts the walk on its own, so a
   tag-only match still passes here - verified by sabotage. The name check is defence against that row
   moving, not something a fixture can witness today. */
struct Voice { int note; float gain }
global Voice array deadVoices[3]
global Voice liveVoice

/* A symbolically-sized array field that is actually FILLED. assertFitsExtent puts a
   `! LEQi`/`! FAIL`/skip-label guard between this global's header and its DATA rows, which split the
   data block in two and left the rows orphaned - `deadStrip` threw outright on any module of this
   shape, i.e. exactly what the feature exists to enable. Nothing crossed the two halves before: the
   struct case above was added for the layout walk, not for a filled initializer. */
struct Tail { int lead; int array vals[BUF_SIZE] }
global Tail tail = { lead: 4, vals: { 6, 3 } }

export function main() locals int i {
	printInt(used(41)); printLF();
	for (i = 0 to 5) { printInt(global KEPT[i]); printLF(); }
	global buf[0] = 7;
	printInt(global buf[0]); printLF();
	global liveVoice.note = 5;
	printInt(global liveVoice.note); printLF();
	printInt(global tail.lead); printLF();
	printInt(global tail.vals[1]); printLF();
}

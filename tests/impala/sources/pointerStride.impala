/* Pointer arithmetic is in ELEMENTS, so `p + n` and `&p[n]` must land on the same struct. They used to
   disagree: `+` strided one WORD while `[]` strided one struct, so `q = p + 1; q->a` silently read
   p[0].b. Every pair below is the two spellings of one address and must print the same value.

   Expected (GAZLCmd pointerStride.gazl main): 20 20 30 30 3 3 3 4 4
*/
extern native printInt
extern native printLF

struct S { int a; int b; int c }

global S array bank[4] = { { 10, 0, 0 }, { 20, 0, 0 }, { 30, 0, 0 }, { 40, 0, 0 } }
global int array words[6] = { 1, 2, 3, 4, 4, 4 }

export function main() locals S pointer p, S pointer q, int pointer w, int pointer v, int n, int i {
	p = &global bank[0];

	q = p + 1;                          // constant offset: folds to `! MULi` + one ADDp, no runtime cost
	printInt(q->a); printLF();
	printInt(p[1].a); printLF();

	i = 2;
	q = p + i;                          // runtime offset: one real MULi, same as `a[i]` already pays
	printInt(q->a); printLF();
	printInt(p[i].a); printLF();

	q = &global bank[3];
	n = q - p;                          // difference comes back in elements: DIFp then DIVi #.z.S
	printInt(n); printLF();
	n = q - &global bank[0];
	printInt(n); printLF();
	q = p - 1 + 4;                      // subtraction scales too
	n = q - p;
	printInt(n); printLF();

	/* A word-sized element strides by one, so these emit a bare ADDp/DIFp exactly as they always did. */
	w = &global words[0];
	v = w + 3;
	printInt(*v); printLF();
	printInt(w[3]); printLF();
}

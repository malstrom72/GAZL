/*
	An `extern struct` array field states NO extent, exactly like a standalone `extern array`
	("`extern array` declaration should not include array size", Impala 1.0). The host owns that
	layout: field positions come from host-supplied `.o.Name.field` symbols and a 1-D element stride
	is 1, so Impala never reads the extent. A number here would be an unverifiable claim - stating
	one is E430, omitting it anywhere else is E431.

	The signature row carries `a : int[]`, the same "extent unknown" wildcard gazl-validate skips
	rather than comparing.

	Compile-only golden. To run: prepend a host header, e.g.
	    .o.Grid.n:    ! DEFi #0
	    .o.Grid.cells:! DEFi #1
	    .o.Grid.tag:  ! DEFi #9
	    .z.Grid:      ! DEFi #10
*/

const int DEBUG = 1

extern struct Grid { int n; int array cells; float tag }

extern native printInt
extern native printFloat
extern native printLF

function sum(Grid pointer g) returns int total
locals int i
{
	total = 0;
	for (i = 0 to 4) total = total + g->cells[i];		// .o.Grid.cells + i, stride 1
}

function poke(Grid pointer g, int i, int v) { g->cells[i] = v; }

function main()
locals int array raw[10], Grid pointer g
{
	g = (Grid pointer)&raw[0];
	g->n = 4; g->tag = 0.5;
	poke(g, 0, 10); poke(g, 1, 20); poke(g, 2, 30); poke(g, 3, 40);
	printInt(sum(g)); printLF();
	printInt(g->n); printLF();
	printFloat(g->tag); printLF();
}

; Text-lane seed: TAIL. A deep self tail loop, mutual tail recursion, a tail call through a target variable, a tail
; call to a GAZL 1 function and one whose window is wider than the caller's own frame.
;   output/GAZLCmd tests/fuzz/textSeeds/gazl2Tail.gazl main      ; 200024059

;-------------------------------------------------------------------------------
g1Triple:               FUNC
    r:                  OUTi
    x:                  INPi
;-------------------------------------------------------------------------------
                        MULi r x #3
                        RETU

                        GAZL #2

;-------------------------------------------------------------------------------
sumTo:                  FUNC
    r:                  OUTi
    n:                  INPi
    acc:                INPi
;-------------------------------------------------------------------------------
                        NEQi n #0 @more
                        MOVi r acc
                        RETU
    more:               SUBi %1 n #1
                        ADDi %2 acc n
                        TAIL &sumTo *3

;-------------------------------------------------------------------------------
isEven:                 FUNC
    r:                  OUTi
    n:                  INPi
;-------------------------------------------------------------------------------
                        NEQi n #0 @more
                        MOVi r #1
                        RETU
    more:               SUBi %1 n #1
                        TAIL &isOdd *2

;-------------------------------------------------------------------------------
isOdd:                  FUNC
    r:                  OUTi
    n:                  INPi
;-------------------------------------------------------------------------------
                        NEQi n #0 @more
                        MOVi r #0
                        RETU
    more:               SUBi %1 n #1
                        TAIL &isEven *2

;-------------------------------------------------------------------------------
madd:                   FUNC
    r:                  OUTi
    a:                  INPi
    b:                  INPi
    c:                  INPi
;-------------------------------------------------------------------------------
                        MULi r a b
                        ADDi r r c
                        RETU

;-------------------------------------------------------------------------------
widen:                  FUNC                            ; two words of its own, tail-calls with four
    r:                  OUTi
    x:                  INPi
;-------------------------------------------------------------------------------
                        MOVi %1 x
                        MOVi %2 #10
                        MOVi %3 #7
                        TAIL &madd *4

;-------------------------------------------------------------------------------
dispatch:               FUNC
    r:                  OUTi
    k:                  INPi
    x:                  INPi
    t:                  LOCt
;-------------------------------------------------------------------------------
                        PEEK t &handlers k
                        MOVi %1 x
                        TAIL t *2

;-------------------------------------------------------------------------------
toGazl1:                FUNC
    r:                  OUTi
    x:                  INPi
;-------------------------------------------------------------------------------
                        ADDi %1 x #1
                        TAIL &g1Triple *2

;-------------------------------------------------------------------------------
handlers:               CNST *3
;-------------------------------------------------------------------------------
                        DATt &widen &toGazl1 &isEven

;-------------------------------------------------------------------------------
main:                   FUNC
    sum:                LOCi
    k:                  LOCi
;-------------------------------------------------------------------------------
                        MOVi %1 #20000
                        MOVi %2 #0
                        CALL &sumTo %0 *3
                        MOVi sum %0                     ; 200010000
                        MOVi %1 #1000
                        CALL &isEven %0 *2
                        MULi %0 %0 #1000
                        ADDi sum sum %0                 ; + 1000
                        MOVi %1 #1001
                        CALL &isOdd %0 *2
                        ADDi sum sum %0                 ; + 1
                        MOVi k #0
    loop:               MOVi %1 k
                        MOVi %2 #1000
                        CALL &dispatch %0 *3
                        ADDi sum sum %0                 ; + 10007, 3003, 1
                        FORi k #3 @loop
                        MOVi %1 #4
                        CALL &widen %0 *2
                        ADDi sum sum %0                 ; + 47
                        MOVi %1 sum
                        CALL ^printInt %0 *2
                        RETU

                        GAZL #1

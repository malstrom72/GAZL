        var LF = '\n';
        output('; Compiled with Impala version ' +
               $$parser.IMPALA_VERSION + LF);
        output('; signatures version=1');
    };

    $$parser.end = function () {

        /* dump deferred string literals */
        iterate($$parser.strings.s, function (rec) {
            $$parser.dumpString(rec.name, rec.data);
        });

        /* dump assert strings only if present */
        if ($$parser.strings.a.length > 0) {

            output('\t! EQUi #DEBUG #0 @.noAssertStrings');

            iterate($$parser.strings.a, function (rec) {
                $$parser.dumpString(rec.name, rec.data);
            });

            output('.noAssertStrings:\t!');
        }
    };
}

#################
#    Grammar    #
#################

# A `; signature` row is emitted once the whole declaration has parsed, and by then the parse
# position has run past its trailing whitespace and comments onto the NEXT declaration - so an
# origin taken there names the wrong line. Each declaration records where it STARTED instead;
# every emit site reports `$$parser.declOffset`, error sites keep using the precise `$$i`.
root        <-  _                                                     { $$parser.start(); }
                ( { $$parser.declOffset = $$i; $$parser.declSource = $$s; }
                  (ImportDecl / ExportDecl / FuncDecl / StructDecl / FuncTypeDecl / ExternDecl / ConstDecl
                  / GlobalDecl / ';'_) )* !.                          { $$parser.end(); }

# `import "path"` names a unit for the builder's link closure. The compiler itself treats it
# as a no-op - `impala build` resolves the closure, concatenates the sources, and compiles the
# whole program at once, so the import directives are already satisfied by that point.
ImportDecl  <-  IMPORT _ path:StringLiteral _

# An `export` prefix marks a definition host-visible (Step 5). It rides the `; signature`
# metadata as a role prefix and is only load-bearing under the builder's `--dead-strip`.
ExportDecl  <-  EXPORT _                                              { $$parser.exportNext = true; }
                (FuncDecl / GlobalDecl / ConstDecl)                   { $$parser.exportNext = false; }

# ------------------------------------------------------------------
#  struct definition
# ------------------------------------------------------------------
StructDecl  <-  STRUCT _ { $nmAt = $$i; } id:Identifier              { $sname = $id; $$parser.beginStruct($id, $$s, $nmAt); }
                '{' _
                ( f:(ArrayDecl / VarDecl)                            {
                                                                         $$parser.addStructField($sname,
                                                                             { name: $f.name, type: $f.type, elem: $f.elem,
                                                                               struct: $f.struct, size: $f.size },
                                                                             $$s, $$i);
                                                                     }
                  ( ';' _ )?
                )*
                '}' _                                                {   $$parser.endStruct($sname);
                                                                         /* Publish the real layout with TYPES so gazl-validate can check an `extern struct`
                                                                            declaration of the same name against it - the .o./.z. constants alone carry no types. */
                                                                         emitStandaloneSignatureComment(
                                                                             $$parser.structSignatureRow($sname, false, $$parser.sourceName, $$s, $$parser.declOffset));
                                                                     }

# ------------------------------------------------------------------
#  named function-pointer type   (Impala 2 Step 3)
#    functype Name(params) [returns t1, t2, ...]
#  Emits nothing - it only registers a signature usable as a base type.
# ------------------------------------------------------------------
FuncTypeDecl <- FUNCTYPE _ { $nmAt = $$i; } id:Identifier            { $ftname = $id; $$parser.beginFuncType($id, $$s, $nmAt); }
                '(' _
                ( p:TypeDeclr                                        { $$parser.addFuncTypeParam($ftname, $p.type, $p.elem, $p.struct, $p.words, $p.name, $$s, $$i); }
                  ( ',' _ p:TypeDeclr                                { $$parser.addFuncTypeParam($ftname, $p.type, $p.elem, $p.struct, $p.words, $p.name, $$s, $$i); }
                  )*
                )?
                ')' _
                ( RETURNS _ r:TypeDeclr                              { $$parser.addFuncTypeReturn($ftname, $r.type, $r.elem, $r.struct, $r.words, $$s, $$i); }
                  ( ',' _ r:TypeDeclr                                {   /* PARKED for Impala 3.0 - see docs/ParkedFeatures.md */
                                                                       $$parser.fail('Multiple return values are not supported in Impala 2.0',
                                                                               $$s, $$i, 'E428',
                                                                               'declare a single return type for this funcptr type');
                                                                     }
                  )*
                )?                                                   { $$parser.endFuncType($ftname); }

# A type with optional variable name (funcptr-type params & returns allow types-only).
TypeDeclr   <-  base:TypeBase                                        { $desc = $base; }
                ( POINTER _                                          { $desc = 'p:' + $desc; }
                )*
                ( id:Identifier                                      { $$.name = $id; }
                )?                                                   {
                                                                         var td = $$parser.descTypeElem($desc);
                                                                         if (td.elem === undefined && $$parser.isStructAtom(td.type)) {
                                                                             $$.type = 'S'; $$.struct = td.type; $$.elem = undefined;
                                                                             $$.words = $$parser.structWords(td.type);
                                                                         } else {
                                                                             $$.type = td.type; $$.elem = td.elem; $$.struct = undefined;
                                                                             $$.words = (td.type === 'F' ? 1 : undefined);   /* scalar funcptr: one word */
                                                                         }
                                                                     }

# ------------------------------------------------------------------
#  function declaration
# ------------------------------------------------------------------
FuncDecl    <-                                                        { $inl = false; }
                ( INLINE                                              { $inl = true; $inlAt = $$i; }
                  _
                )?
                FUNCTION _ { $fnAt = $$i; } id:Identifier '('_        {
                                                                         if ($inl) {   /* PARKED for Impala 3.0 - see docs/ParkedFeatures.md */
                                                                             $$parser.fail('Inline functions are not supported in Impala 2.0',
                                                                                     $$s, $inlAt, 'E439',
                                                                                     'an expansion needs GAZL 2 `SCOP` / `ENDS` to place its locals; '
                                                                                             + 'drop `inline` to compile it as an ordinary function');
                                                                         }
                                                                         assert($$parser.validateStock('%'));
                                                                         assert($$parser.validateStock('<'));
                                                                         /* every compile-time scratch borrowed by the previous function/globals must be
                                                                            back in the pool at this clean boundary - catches offset-scratch leaks at the source */
                                                                         assert($$parser.stock['<'].length === $$parser.counters['<'],
                                                                                 'compile-time scratch leak before ' + $id + ': '
                                                                                 + ($$parser.counters['<'] - $$parser.stock['<'].length) + ' unreturned');

                                                                         output('');
                                                                         output(';-----------------------------------------------------------------------------');

                                                                         /* declare the function symbol */
                                                                         $$parser.declare(
                                                                             undefined,
                                                                             'functions',
                                                                             $id,
                                                                             'U',
                                                                             true,
                                                                             undefined,
                                                                             $$s, $fnAt   /* the NAME, not the `(` this action already ate */
                                                                         );
                                                                         var entry = $$parser.symbols.functions[$id];
                                                                         if (entry) {
                                                                             if (!entry.signature) {
                                                                                 entry.signature = {};
                                                                             }
                                                                             entry.signature.params = [];
                                                                             entry.signature.returns = '?';
                                                                             entry.signature.returnElem = undefined;
                                                                             entry.signature.returnName = undefined;
                                                                             entry.signature.sourceCode = $$s;
                                                                             entry.signature.sourceOffset = $$parser.declOffset;
                                                                             entry.signature.sourceName = $$parser.sourceName;
                                                                             entry.signature.returnResolved = false;
                                                                             entry.pendingReturnPlaceholder = undefined;
                                                                             entry.pendingReturnDeclaration = undefined;
                                                                         }
                                                                     }
inp:ArgsDecl ')'_
(
                    RETURNS _ out:VarDecl                             {
                                                                         var entry = $$parser.symbols.functions[$id];
                                                                         if (entry) {
                                                                             entry.pendingReturns = undefined;
                                                                             $$parser.addReturn(entry, $out.name, $out.type, $out.elem, $out.size, $$s, $$i, $out.struct, $out.words);
                                                                         }
                                                                     }
                    ( ',' _ v:VarDecl                                 {   /* PARKED for Impala 3.0 - see docs/ParkedFeatures.md */
                                                                         $$parser.fail('Multiple return values are not supported in Impala 2.0',
                                                                                 $$s, $$i, 'E428',
                                                                                 'return one value, or pass extra results back through pointer out-parameters');
                                                                     }
                    )*
                                                                     {
                                                                         var entry = $$parser.symbols.functions[$id];
                                                                         if (entry && entry.signature) {
                                                                             var rl = entry.pendingReturns;
                                                                             entry.signature.returnList = rl;
                                                                             entry.signature.returnCount = rl.length;
                                                                             entry.signature.returns = rl[0].type;
                                                                             entry.signature.returnElem = rl[0].elem;
                                                                             entry.signature.returnName = rl[0].rawName;
                                                                             entry.signature.returnStruct = rl[0].struct;
                                                                             var _rw = 0;                    /* total output-window words (struct returns span >1) */
                                                                             for (var _wi = 0; _wi < rl.length; ++_wi)
                                                                                 _rw += (rl[_wi].type === 'S' ? rl[_wi].words : 1);
                                                                             entry.signature.returnWords = _rw;
                                                                             $$parser.resolveFunctionReturnType($id, rl[0].type, $$s, $$i);
                                                                         }
                                                                     }
                    /
                                                                    {
                                                                        /* implicit 1-word return: even void functions expose
                                                                           a single-word PARA so legacy call sites keep a
                                                                           deterministic return slot and the JSPEG output
                                                                           matches the historical PPEG layout. */
								var entry = $$parser.symbols.functions[$id];
								if (entry) {
									entry.pendingReturns = undefined;
									entry.pendingReturnPlaceholder = {
										sourceCode: $$s,
										sourceOffset: $$i
									};
								}
								if (entry && entry.signature) {
									entry.signature.returns = 'V';
									entry.signature.returnElem = undefined;
									entry.signature.returnName = undefined;
									entry.signature.returnCount = 0;
									entry.signature.returnList = [];
									$$parser.resolveFunctionReturnType($id, 'V', $$s, $$i);
								}
                                                                     }
                )                                                     {
                                                                         /* declare input parameters */
                                                                         var entry = $$parser.symbols.functions[$id];
                                                                         if (entry && entry.signature) {
                                                                             entry.signature.params = [];
                                                                             for (var idx = 0; idx < $inp.n; ++idx) {
                                                                                 var param = $inp[idx];
                                                                                 entry.signature.params.push({
                                                                                     type: param.type,
                                                                                     elem: param.elem,
                                                                                     name: param.name,
                                                                                     size: param.size,
                                                                                     struct: param.struct,
                                                                                     words: param.words
                                                                                 });
                                                                             }
                                                                         }
                                                                $$parser.emitFunctionSignature($id, $$s, $$i);
                                                                if (entry) {
                                                                        if (entry.pendingReturns && entry.pendingReturns.length > 0) {
                                                                                for (var _ri = 0; _ri < entry.pendingReturns.length; ++_ri) {
                                                                                        var ret = entry.pendingReturns[_ri];
                                                                                        $$parser.rejectByValueStruct(ret.type, ret.struct, ret.rawName, true, ret.sourceCode, ret.sourceOffset);
                                                                                        {
                                                                                                $$parser.declare(
                                                                                                        'OUT?', 'locals',
                                                                                                        ret.name,
                                                                                                        ret.type,
                                                                                                        false,
                                                                                                        ret.size,
                                                                                                        ret.sourceCode,
                                                                                                        ret.sourceOffset,
                                                                                                        undefined,
                                                                                                        ret.elem
                                                                                                );
                                                                                        }
                                                                                }
                                                                                entry.pendingReturns = undefined;
                                                                        } else if (entry.pendingReturnPlaceholder) {
                                                                                var placeholder = entry.pendingReturnPlaceholder;
                                                                                $$parser.declare(
                                                                                        'PARA', 'locals',
                                                                                        undefined, '?',
                                                                                        false, '*1',
                                                                                        placeholder.sourceCode,
                                                                                        placeholder.sourceOffset
                                                                                );
                                                                                entry.pendingReturnPlaceholder = undefined;
                                                                        }
                                                                }
                                                                         iterate($inp, function (p) {
                                                                             $$parser.rejectByValueStruct(p.type, p.struct, p.name, false, $$s, p.at);
                                                                             {
                                                                                 $$parser.declare(
                                                                                     'INP?', 'locals',
                                                                                     '$' + p.name,
                                                                                     p.type,
                                                                                     true,
                                                                                     (p.size !== undefined ? '*' + p.size : undefined),
                                                                                     $$s, p.at,
                                                                                     undefined,
                                                                                     p.elem
                                                                                 );
                                                                             }
                                                                         });
                                                                     }
                (
                    LOCALS _ loc:LocalsDecl                           {
                                                                         iterate($loc, function (v) {
                                                                             if (v.type === 'S') {         /* struct value local -> LOCA *sizeof, remember struct */
                                                                                 $$parser.declare(
                                                                                     'LOCA', 'locals',
                                                                                     '$' + v.name,
                                                                                     'S',
                                                                                     false,
                                                                                     $$parser.structAllocSize(v.struct),
                                                                                     $$s, v.at,
                                                                                     undefined,
                                                                                     v.struct
                                                                                 );
                                                                             } else {
                                                                                 $$parser.declare(
                                                                                     'LOC?', 'locals',
                                                                                     '$' + v.name,
                                                                                     v.type,
                                                                                     false,
                                                                                     (v.type === 'A'
                                                                                         ? $$parser.arrayAllocSize(v.elem, v.size,
                                                                                                 $$parser.extentSymbol(v.name, $id))
                                                                                         : (v.words !== undefined ? '*' + v.words : undefined)),
                                                                                     $$s, v.at,
                                                                                     undefined,
                                                                                     v.elem
                                                                                 );
                                                                             }
                                                                             if (v.type === 'A') {   /* the ONLY place the owning function's
                                                                                                        name is in scope, so what a later subscript
                                                                                                        needs to bounds-check this array is recorded
                                                                                                        here - see arrayExtent's shape */
                                                                                 $$parser.symbols.locals['$' + v.name].extent =
                                                                                         { n: v.size, what: v.name,
                                                                                           sym: $$parser.extentSymbol(v.name, $id) };
                                                                             }
                                                                         });
                                                                         iterate($loc, function (v) {   /* the count scratches ArrayDecl held for this
                                                                                                           clause (see there); a no-op for the ones a
                                                                                                           declaration above already gave back */
                                                                             $$parser.returnBack(v.size);
                                                                         });
                                                                     }
                )?                                                    { output(';-----------------------------------------------------------------------------'); }
                Block                                                 {
                                                                         /* wrap-up body */
                                                                         /* The closing RETU goes in BEFORE the pass, so the pass can
                                                                            see it: `goto out;` where `out:` is the end-of-body label is
                                                                            Impala's only early-exit idiom, and it lands exactly here. */
                                                                         $$parser.emit('--^', undefined, undefined, undefined, undefined);
                                                                         $$parser.processBranches();
                                                                         $$parser.flushMetaCode('\t');
                                                                         $$parser.emittedGuards = {};   /* per function: labels are too */

                                                                         prune($$parser.symbols.locals);
                                                                         $$parser.labelCounter = 0;

                                                                         output('');
                                                                     }
ExternDecl  <-  EXTERN _                                              { $$.scope = 'globals'; $$.structFwd = false;
                                                                        $at = $$i;   /* the declaration itself - end-of-rule positions have skipped past it */
                                                                        $$parser.pendingProto = undefined; }
                (
                    STRUCT _ id:Identifier                            {
                                                                         $$.structFwd = true;
                                                                         $sname = $id;
                                                                         $$parser.beginExternStruct($id, $$s, $$i);
                                                                     }
                    ( '{' _                                           { /* a bodyless `extern struct G` never reaches
                                                                           endStruct, so only the braced form opens */
                                                                        $$parser.openStruct = $sname; }
                      ( f:(ArrayDecl / VarDecl)                       {
                                                                         $$parser.addStructField($sname,
                                                                             { name: $f.name, type: $f.type, elem: $f.elem,
                                                                               struct: $f.struct, size: $f.size },
                                                                             $$s, $$i);
                                                                     }
                        ( ';' _ )?
                      )*
                      '}' _                                           {   /* Declare the host-owned interface so gazl-validate can check the layout
                                                                             the host supplies (.o.Name.field / .z.Name) against what Impala assumed,
                                                                             the way extern globals and function signatures are already checked. A
                                                                             re-declaration of a struct DEFINED here describes no host layout, so it
                                                                             publishes no row - the definition already published the real one. */
                                                                          if (!$$parser.endStruct($sname)) {
                                                                              emitStandaloneSignatureComment(
                                                                                  $$parser.structSignatureRow(
                                                                                      $sname, true, $$parser.sourceName, $$s, $$parser.declOffset));
                                                                          }
                                                                      }
                    )?
                /   (   FUNCTION                                      { $$.type  = 'U';  $$.scope = 'functions'; }
                    /   NATIVE                                        { $$.type  = 'N';  $$.scope = 'functions'; }
                    ) _ { $nmAt = $$i; } id:Identifier                { $$.name  = $id; $$.at = $nmAt; }
                    ( '(' _ inp:ArgsDecl ')' _                        {   /* Optional PROTOTYPE. Name-only stays valid and
                                                                             asserts nothing (a wildcard the validator skips);
                                                                             a prototype is a checkable assertion, so calls get
                                                                             argument type-checking and the emitted signature
                                                                             row carries real types. */
                                                                        var _pa = [];
                                                                        for (var _pk = 0; _pk < $inp.n; ++_pk) {
                                                                            var _pv = $inp[_pk];
                                                                            _pa.push({ type: _pv.type, elem: _pv.elem, name: _pv.name,
                                                                                       size: _pv.size, struct: _pv.struct, words: _pv.words });
                                                                        }
                                                                        $$parser.pendingProto = { args: _pa, ret: undefined };
                                                                      }
                      ( RETURNS _ out:VarDecl                         { if ($$parser.pendingProto) $$parser.pendingProto.ret = { type: $out.type, elem: $out.elem, struct: $out.struct, name: $out.name }; }
                        ( ',' _ VarDecl                               {   /* PARKED for Impala 3.0 - see docs/ParkedFeatures.md */
                                                                          $$parser.fail('Multiple return values are not supported in Impala 2.0',
                                                                                  $$s, $$i, 'E428',
                                                                                  'declare a single return value for this extern');
                                                                      }
                        )*
                      )?
                    )?
                /                                                     { $desc = undefined; }
                    ( type:BASE_TYPE _                                { $desc = $$parser.CASTS_TO_TYPES[$type]; }
                      ( POINTER _                                     { $desc = 'p:' + $desc; }
                      )*
                    )?
                    ARRAY _ { $nmAt = $$i; } id:Identifier            {
                                                                         $$.type = 'A';
                                                                         $$.name = $id;
                                                                         $$.at   = $nmAt;
                                                                         $$.elem = $desc;
                                                                     }
                /   VarDecl
                )                                                     {
                                                                        if ($$.structFwd) {
                                                                            $$parser.cancelStructRedeclaration($sname);
                                                                            return true;
                                                                        }
                                                                         $$parser.declare(
                                                                             undefined,                 // no section for extern
                                                                             $$.scope,
                                                                             $$.name,
                                                                             $$.type,
                                                                             false,                     // not readonly
                                                                             '?',
                                                                             $$s, $$.at,
                                                                             undefined,
                                                                             $$.elem
                                                                         );
                                                                         if ($$.scope === 'functions') {
                                                                             var entry = $$parser.symbols.functions[$$.name];
                                                                             var signature = entry && entry.signature;

                                                                             if (entry) {
                                                                             if (!signature) {
                                                                                 signature = entry.signature = {};
                                                                             }
                                                                             if (signature.sourceName === undefined) {
                                                                                 signature.sourceName = $$parser.sourceName;
                                                                             }
                                                                             if (signature.sourceCode === undefined) {
                                                                                 signature.sourceCode = $$s;
                                                                                 signature.sourceOffset = $$parser.declOffset;
                                                                                 signature.sourceName = $$parser.sourceName;
                                                                             }
                                                                             if (entry.kind !== 'FUNC') {  /* a definition here already resolved it - do not un-resolve it */
                                                                                 signature.returnResolved = false;
                                                                             }
                                                                        }

                                                                        var role = ($$.type === 'N' ? 'extern native' : 'extern func');
                                                                        var placeholderSignature = {
                                                                            params: [],
                                                                            returns: undefined,
                                                                            sourceName: $$parser.sourceName,
                                                                            sourceCode: $$s,
                                                                            sourceOffset: $$parser.declOffset,
                                                                        };
                                                                                                                                                var _proto = $$parser.pendingProto;
                                                                        $$parser.pendingProto = undefined;
                                                                        if (_proto !== undefined) {   /* a declared prototype: real params + at most one return */
                                                                            var _pp = [];
                                                                            for (var _pi = 0; _pi < _proto.args.length; ++_pi) {
                                                                                var _p = _proto.args[_pi];
                                                                                $$parser.rejectByValueStruct(_p.type, _p.struct, _p.name, false, $$s, $at);
                                                                                _pp.push({ type: _p.type, elem: _p.elem, name: _p.name,
                                                                                           size: _p.size, struct: _p.struct, words: _p.words });
                                                                            }
                                                                            var _pr = _proto.ret;
                                                                            if (_pr !== undefined) $$parser.rejectByValueStruct(_pr.type, _pr.struct, _pr.name, true, $$s, $at);
                                                                            placeholderSignature.params      = _pp;
                                                                            placeholderSignature.returns     = (_pr !== undefined ? _pr.type : 'V');
                                                                            placeholderSignature.returnElem  = (_pr !== undefined ? _pr.elem : undefined);
                                                                            placeholderSignature.returnCount = (_pr !== undefined ? 1 : 0);
                                                                            placeholderSignature.returnWords = (_pr !== undefined ? 1 : 0);
                                                                            placeholderSignature.returnResolved = true;
                                                                            if (entry) {
                                                                                var _defined = (entry.kind === 'FUNC');
                                                                                $$parser.checkExternAgreement($$.name, placeholderSignature,
                                                                                        (_defined ? entry.signature : entry.externProto), _defined, $$s, $at);
                                                                                entry.externProto = placeholderSignature;
                                                                                if (!_defined) {               /* a definition here outranks it; otherwise publish
                                                                                                                  it so call sites check against it */
                                                                                    entry.signature.params         = _pp;
                                                                                    entry.signature.returns        = placeholderSignature.returns;
                                                                                    entry.signature.returnElem     = placeholderSignature.returnElem;
                                                                                    entry.signature.returnCount    = placeholderSignature.returnCount;
                                                                                    entry.signature.returnWords    = placeholderSignature.returnWords;
                                                                                    entry.signature.returnResolved = true;
                                                                                }
                                                                            }
                                                                        }
                                                                        emitStandaloneSignatureComment(
                                                                            $$parser.formatFunctionSignatureComment(
                                                                                $$.name,
                                                                                placeholderSignature,
                                                                                role,
                                                                                $$parser.sourceName,
                                                                                $$s,
                                                                                $$parser.declOffset
                                                                            )
                                                                        );
                                                                         } else if ($$.scope === 'globals') {
                                                                            emitStandaloneSignatureComment(
                                                                                $$parser.formatGlobalSignatureComment(
                                                                                    'GLOB',
                                                                                    $$.name,
                                                                                    $$.type,
                                                                                    $$.size,
                                                                                    'extern',
                                                                                    $$parser.sourceName,
                                                                                    $$s,
                                                                                    $$parser.declOffset,
                                                                                    $$.elem
                                                                                )
                                                                            );
                                                                        }
                                                                    }

ConstDecl   <-  CONST _ base:TypeBase                                 {
                                                                         /* Same type grammar as every other declarator (TypeBase, not
                                                                            bare BASE_TYPE), so a const can name a struct pointer or a
                                                                            named functype - a const is an assembler-level address/scalar
                                                                            constant, and those two are just addresses. A struct VALUE is
                                                                            the one shape that has no scalar constant form. */
                                                                         $desc = $base;
                                                                         $nf = $$parser.noForward;
                                                                         $$parser.noForward = true;
                                                                     }
                 ( POINTER _                                          { $desc = 'p:' + $desc; }
                 )*
                                                                      {
                                                                         var cd = $$parser.descTypeElem($desc);
                                                                         if (cd.elem === undefined && $$parser.isStructAtom(cd.type)) {
                                                                             $$parser.fail('A const cannot be a struct value - use a struct pointer ('
                                                                                     + 'const ' + cd.type + ' pointer)', $$s, $$i, 'E447');
                                                                         }
                                                                         $t = cd.type; $telem = cd.elem;    /* 'F' + name for a funcptr constant */
                                                                         $cStart = $$i;   /* `Identifier` eats trailing space, so $$i
                                                                                             would name the NEXT declaration (E453) */
                                                                      }
                 id:Identifier
                 (   '=' _                                            { $cInitStart = $$i; }   # `Expr` eats trailing space,
                                                                                               # so $$i would name the NEXT declaration
                     x:Expr                                           {
                                                                            $$parser.checkInitTarget($t, $telem, $x, $$s, $cInitStart);
                                                                            $$parser.declare(
                                                                                '! DEF?', 'defines',
                                                                                $id, $t, true,
                                                                                $$parser.makeConstant($x, $t, $$s, $cInitStart),
                                                                                $$s, $cStart,
                                                                                $$parser.formatConstSignatureComment(
                                                                                    $id,
                                                                                    $t,
                                                                                    $$parser.sourceName,
                                                                                    $$s,
                                                                                    $$parser.declOffset,
                                                                                    $telem
                                                                                ),
                                                                                $telem
                                                                            );
                                                                         }
                 /                                                     {
                                                                             /* `export` says "this unit provides it"; a valueless const says
                                                                                "someone else does". The row below publishes it as an extern
                                                                                either way, so the keyword was silently dropped. */
                                                                             if ($$parser.exportNext) {
                                                                                 $$parser.fail('`export` contradicts a valueless `const` - '
                                                                                         + $id + ' is provided elsewhere, not by this unit',
                                                                                         $$s, $cStart, 'E453',
                                                                                         'give it a value to export it, or drop `export`');
                                                                             }
                                                                             $$parser.declare(
                                                                                 undefined, 'defines',
                                                                                 $id, $t, true,
                                                                                 undefined,
                                                                                 $$s, $cStart,
                                                                                 undefined,
                                                                                 $telem
                                                                             );
                                                                             emitStandaloneSignatureComment(  /* valueless -> host/runtime defines it: publish it as an extern so it links-checks */
                                                                                 $$parser.formatConstSignatureComment(
                                                                                     $id,
                                                                                     $t,
                                                                                     $$parser.sourceName,
                                                                                     $$s,
                                                                                     $$parser.declOffset,
                                                                                     $telem,
                                                                                     true
                                                                                 )
                                                                             );
                                                                         }
                 )                                                     { $$parser.noForward = $nf; }

GlobalDecl  <-  (   GLOBAL                                            { $section = 'GLOB'; }
                 /  READONLY                                          { $section = 'CNST'; }
                 /  TEMPORARY                                         { $section = 'TEMP'; }
                 ) _
                 (
                     # primitive variable --------------------------------
                     v:VarDecl                                        {
                                                                             $vStruct = ($v.type === 'S');
                                                                             if ($vStruct) {              /* struct value global -> one zeroed GLOB/CNST/TEMP *sizeof */
                                                                                 $$parser.declare(
                                                                                     $section, 'globals',
                                                                                     $v.name, 'S',
                                                                                     ($section === 'CNST'),
                                                                                     $$parser.structAllocSize($v.struct),
                                                                                     $$s, $v.at,
                                                                                     $$parser.formatGlobalSignatureComment(
                                                                                         $section, $v.name, 'S', undefined, undefined,
                                                                                         $$parser.sourceName, $$s, $$parser.declOffset, $v.struct),
                                                                                     $v.struct
                                                                                 );
                                                                             } else {
                                                                                 $$parser.declare(
                                                                                     $section, 'globals',
                                                                                     undefined,
                                                                                     $v.type,
                                                                                     ($section === 'CNST'),
                                                                                     '*1',
                                                                                     $$s, $v.at
                                                                                 );
                                                                                 $init = $$parser.ZEROES[$v.type];
                                                                             }
                                                                         }
                         ( '=' _                                      { $initStart = $$i; }   # `Braced` eats trailing space, so
                                                                                              # $$i would name the NEXT declaration
                           ( d:Braced                              {
                                                                             if (!$vStruct)
                                                                                 $$parser.fail('Brace initializers are only for struct values',
                                                                                         $$s, $initStart, 'E422');
                                                                             $binit = [];
                                                                             $$parser.buildStructInit($v.struct, $d, $binit, $$s, $initStart);
                                                                             $$parser.emitInitData($binit, $$s, $initStart);
                                                                         }
                           / x:Expr                                 {
                                                                             if ($vStruct)                    /* $initStart, not $$i: `Expr`
                                                                                                                 ate the trailing space too */
                                                                                 $$parser.fail('A struct value needs a brace initializer',
                                                                                         $$s, $initStart, 'E421');
                                                                             $$parser.checkInitTarget($v.type, $v.elem, $x, $$s, $initStart);
                                                                             $init = $$parser.makeConstant($x, $v.type, $$s, $initStart);
                                                                         }
                           ) )?
                                                                       {
                                                                            if (!$vStruct)
                                                                            $$parser.declare(
                                                                                'DAT?', 'globals',
                                                                                $v.name,
                                                                                $v.type,
                                                                                ($section === 'CNST'),
                                                                                $init,
                                                                                $$s, $v.at,
                                                                                $$parser.formatGlobalSignatureComment(
                                                                                    $section,
                                                                                    $v.name,
                                                                                    $v.type,
                                                                                    undefined,
                                                                                    undefined,
                                                                                    $$parser.sourceName,
                                                                                    $$s,
                                                                                    $$parser.declOffset,
                                                                                    $v.elem
                                                                                ),
                                                                                $v.elem
                                                                            );
                                                                         }

                   / # array ----------------------------------------------
                     a:ArrayDecl                                      {
                                                                            $$parser.declare(
                                                                                $section, 'globals',
                                                                                $a.name,
                                                                                'A',
                                                                                ($section === 'CNST'),
                                                                                $$parser.arrayAllocSize($a.elem, $a.size,
                                                                                        $$parser.extentSymbol($a.name)),
                                                                                $$s, $a.at,
                                                                                $$parser.formatGlobalSignatureComment(
                                                                                    $section,
                                                                                    $a.name,
                                                                                    'A',
                                                                                    $a.size,
                                                                                    undefined,
                                                                                    $$parser.sourceName,
                                                                                    $$s,
                                                                                    $$parser.declOffset,
                                                                                    $a.elem
                                                                                ),
                                                                                $a.elem
                                                                            );
                                                                            $$parser.symbols.globals[$a.name].extent =
                                                                                    { n: $a.size, what: $a.name,
                                                                                      sym: $$parser.extentSymbol($a.name) };
                                                                            $$parser.returnBack($a.size);   /* declared: this consumer is done with it */
                                                                            $aStructEl = ($a.elem !== undefined
                                                                                    && $$parser.descTail($a.elem) === undefined
                                                                                    && $$parser.isStructAtom($$parser.descHead($a.elem)));
                                                                            $aStruct = $a.elem;
                                                                            $aCount = $$parser.constInt('#' + $a.size);
                                                                         }
                         ( '=' _                                       {   /* the list is fully consumed before these
                                                                              checks run, so $$i would land on the NEXT
                                                                              declaration - name the initializer itself */
                                                                            $initStart = $$i;
                                                                            /* Hand InitList the DECLARED element type. Without it every entry was
                                                                               checked against its own type, which no value can fail, so
                                                                               `int array A[2] = { 1, "s" }` stored a pointer in an int slot and
                                                                               `float array F[2] = { 1, 2 }` stored the INTEGER bit pattern and read
                                                                               back 1.4013e-45. The scalar paths have always been this strict
                                                                               (`global float f = 1` is E407); only the array path was not.
                                                                               A struct-element array keeps reporting the friendlier E422 below, so
                                                                               it states no target at all. */
                                                                            $$parser.initTarget = ($aStructEl ? undefined : $a.elem);
                                                                         }
                           ( d:InitList                                {   /* flat list -> scalar-element arrays only */
                                                                            if ($aStructEl)
                                                                                $$parser.fail('A struct-element array needs nested braces, one group per element',
                                                                                        $$s, $initStart, 'E422');
                                                                         }
                           / d:Braced                                  {   /* nested braces -> struct-element arrays */
                                                                            if (!$aStructEl)
                                                                                $$parser.fail('Nested brace initializers are for struct-element arrays',
                                                                                        $$s, $initStart, 'E422');
                                                                            if (isNaN($aCount))
                                                                                $$parser.fail('An initialized struct-element array needs a literal size',
                                                                                        $$s, $initStart, 'E414');
                                                                            var _arr = $d;
                                                                            if (_arr.length > $aCount) {
                                                                                $$parser.failSurplus($a.name, 'elements', _arr.length, $aCount,
                                                                                        _arr[$aCount] && _arr[$aCount].at, $$s, $initStart);
                                                                            }
                                                                            $binit = [];
                                                                            for (var _ae = 0; _ae < $aCount; ++_ae) {
                                                                                var _aev = (_ae < _arr.length)
                                                                                        ? $$parser.indexedEntry(_arr[_ae], $$s, $initStart) : undefined;
                                                                                $$parser.buildStructInit($aStruct,
                                                                                        (_aev && _aev.braced) || [], $binit, $$s, $initStart);
                                                                            }
                                                                            $$parser.emitInitData($binit, $$s, $initStart);
                                                                         }
                           ) )?
                 )

# ------------------------------------------------------------------
#  Initialiser list for arrays                                  
# ------------------------------------------------------------------
# Nested brace tree of compile-time constants, for struct initializers.
Braced      <-  '{' _                                                { $$ = []; $$.n = 0; }
                ( i:BracedEntry                                      { $$[$$.n++] = $i; }
                  ( ',' _ i:BracedEntry                              { $$[$$.n++] = $i; }
                  )*
                )? '}' _

# `field: value` names a struct field; a bare value is an array element, where the position IS the
# index. One rule for both - which form is legal is decided by the consumer that knows which it is
# (fieldEntries for a struct, indexedEntry for an array slot). The action sits AFTER the ':' so a
# bare `ident` expression does not leave $fname set when the group backtracks.
BracedEntry <-                                                       { $fname = undefined; $fat = $$i; }
                ( id:Identifier ':' _                                { $fname = $id; }
                )?
                e:BracedItem                                         { var _v = $e;   /* bare `$e` is the VALUE; `$e.field`
                                                                                       would set a CONTEXT property, and
                                                                                       `Braced` stores only the value */
                                                                       _v.field = $fname;
                                                                       _v.at = $fat;
                                                                       $$ = _v; }

BracedItem  <-  b:Braced                                             { $$ = { braced: $b }; }
                / x:Expr                                             {
                                                                        var m = metaSlot($x);
                                                                        var op = $$parser.makeRValue(m, '#<&');
                                                                        if (span(op[0] || '', '#<&') !== 1)
                                                                            $$parser.fail('Initializer must be a constant', $$s, $$i, 'E407');
                                                                        $$ = { op: op, type: m.type, elem: m.elem };
                                                                    }

InitList    <-  '{' _                                                 { $d = ' '; $type = undefined; }
                # Decline a `field:` entry so the ordered choice falls through to `Braced`, which owns the
                # named form. Without this, `Expr` evaluates the name first and dies as E403 instead.
                ( !(Identifier ':')                                  { $entryAt = $$i; }   # `Expr` eats the trailing
                                                                                          # space, so $$i would name the NEXT entry
                  x:Expr                                             {
                                                                            var first = $$parser.initEntry(metaSlot($x), $$s, $entryAt);
                                                                            $type = first.type;
                                                                            $d += first.op;
                                                                        }
                  ( ',' _ !(Identifier ':')                          { $entryAt = $$i; }
                    x:Expr                                           {
                                                                            var next = $$parser.initEntry(metaSlot($x), $$s, $entryAt);
                                                                            var xType = next.type, constant = next.op;

                                                                            /* decide if we need to flush DATA */
                                                                            if (  constant[0] === '<'
                                                                              || $d[1] === '<'
                                                                              || ($d + ' ' + constant).length >= 55) {

                                                                                $$parser.declare(
                                                                                    $$parser.initElemRow(), 'globals',
                                                                                    undefined, xType,
                                                                                    true, $d.substr(1),
                                                                                    $$s, $$i
                                                                                );
                                                                                $d = '';
                                                                            }
                                                                            $d += ' ' + constant;
                                                                            $type = xType;
                                                                        }
                  )* )?
              '}' _                                                  {
                                                                        if ($d.substr(1) !== '') {
                                                                            $$parser.declare(
                                                                                $$parser.initElemRow(), 'globals',
                                                                                undefined, $type,
                                                                                true, $d.substr(1),
                                                                                $$s, $$i
                                                                            );
                                                                        }
                                                                    }

# ------------------------------------------------------------------
#  Parameter & local-variable helper lists                      
# ------------------------------------------------------------------
ArgsDecl    <-                                                        {
                                                                         $$ = [];
                                                                         $$.n = 0;
                                                                     }
                 ( v:VarDecl                                          { $$[$$.n++] = $$parser.declEntry($v.type, $v.elem, $v.struct, $v.words, $v.name, $v.size, $v.at); }
                   ( ',' _ v:VarDecl                                  { $$[$$.n++] = $$parser.declEntry($v.type, $v.elem, $v.struct, $v.words, $v.name, $v.size, $v.at); }
                   )*
                 )?

LocalsDecl  <-                                                        {
                                                                         $$ = [];
                                                                         $$.n = 0;
                                                                     }
                 ( v:(VarDecl / ArrayDecl)                            { $$[$$.n++] = $$parser.declEntry($v.type, $v.elem, $v.struct, $v.words, $v.name, $v.size, $v.at); }
                   ( ',' _ v:(VarDecl / ArrayDecl)                    { $$[$$.n++] = $$parser.declEntry($v.type, $v.elem, $v.struct, $v.words, $v.name, $v.size, $v.at); }
                   )*
                 )?

# ------------------------------------------------------------------
#  Simple variable & array declarators                          
# ------------------------------------------------------------------
# A leading type atom: a primitive keyword, or the name of a defined struct.
TypeBase    <-  t:BASE_TYPE _                                         { $$ = $$parser.CASTS_TO_TYPES[$t]; }
              / id:Identifier                                        {
                                                                         if (!$$parser.isStructAtom($id) && !$$parser.isFuncTypeAtom($id))
                                                                             $$parser.fail('Unknown type ' + $id, $$s, $$i, 'E413');
                                                                         $$ = $id;
                                                                     }

VarDecl     <-  base:TypeBase                                        { $desc = $base; }
                ( POINTER _                                           { $desc = 'p:' + $desc; }
                )*
                { $nameStart = $$i; }
                id:Identifier                                         {
                                                                         $$parser.checkReservedName($id, 'variable', $$s, $nameStart);
                                                                         var vd = $$parser.descTypeElem($desc);
                                                                         if (vd.elem === undefined && $$parser.isStructAtom(vd.type)) {
                                                                             $$.type = 'S';
                                                                             $$.struct = vd.type;
                                                                             $$.elem = undefined;
                                                                             $$.words = $$parser.structWords(vd.type);
                                                                         } else {
                                                                             $$.type = vd.type;       /* 'F' + the name for a named funcptr type */
                                                                             $$.elem = vd.elem;
                                                                             $$.struct = undefined;
                                                                             $$.words = undefined;    /* scalar: a single word, no size operand */
                                                                         }
                                                                         $$.name = $id;
                                                                         $$.at   = $nameStart;   /* the NAME - `Identifier` ate the trailing
                                                                                                    space, so an end-of-rule $$i would name
                                                                                                    the NEXT declaration */
                                                                         $$.size = undefined;
                                                                     }

ArrayDecl   <-                                                        { $desc = undefined; $extent = undefined; }
                ( base:TypeBase                                      { $desc = $base; }
                  ( POINTER _                                         { $desc = 'p:' + $desc; }
                  )*
                )?
                ARRAY _ { $nameStart = $$i; } id:Identifier           { $$parser.checkReservedName($id, 'array', $$s, $nameStart); }
                ( '[' _                                               { $extentStart = $$i; }   # `']' _` eats the trailing
                                                                                               # space, so $$i would name the NEXT declaration
                  x:Expr ']' _                                        {
                                                                         $size = $$parser.makeConstant($x, 'i', $$s, $extentStart);
                                                                         /* A NEGATIVE extent runs the layout BACKWARDS. On a plain array the assembler
                                                                            catches it, because the count reaches it as a `GLOB *size` / `LOCA *size`
                                                                            operand it type-checks ("Incompatible types: .z.g"). A struct FIELD's count
                                                                            is only ever ADDED into the offset accumulator, which subtracts without
                                                                            complaint - `struct T { int a; int array b[-1]; int c }` compiles,
                                                                            assembles, runs, and puts `a` and `c` in the SAME WORD. Rejected here, at
                                                                            the declaration, because that is where the extent is still a number and
                                                                            where the invariant belongs. Zero is left alone: it wastes a field but
                                                                            aliases nothing, and every constant index into it is already out of range. */
                                                                         if ($$parser.constInt($size) < 0)
                                                                             $$parser.fail('Array extent is negative: ' + $$parser.dropHash($size),
                                                                                     $$s, $extentStart, 'E462',
                                                                                     'an array holds zero or more elements');
                                                                         $extent = $$parser.dropHash($size);   /* element count - may be a symbolic const */
                                                                         /* THE CONSUMER OWNS THE BORROW. A folded extent lives in a `<X>` scratch, and
                                                                            a scratch is recycled on the next borrow - so whoever still has to READ this
                                                                            one decides when it goes back: endStruct after the layout block, FuncDecl
                                                                            after the locals pass, GlobalDecl right after its declaration. Freeing it
                                                                            here instead let the NEXT declarator in the same list borrow the same
                                                                            scratch and overwrite the extent, which is how two array locals in one
                                                                            clause silently got whichever count was folded last. */
                                                                     }
                )?                                                    {
                                                                         /* An `extern struct` field states NO extent, matching the
                                                                            `extern array` rule: the host owns that layout, so a number
                                                                            here would be an unverifiable claim Impala never reads
                                                                            (offsets are host-supplied `.o.` symbols, 1-D stride is 1). */
                                                                         var externField = ($$parser.openStruct !== undefined
                                                                                 && $$parser.isExternStruct($$parser.openStruct));
                                                                         if (externField && $extent !== undefined) {
                                                                             $$parser.fail('An extern struct array field must not state a size',
                                                                                     $$s, $$i, 'E430',
                                                                                     'the host owns this layout - write `array ' + $id + '` without a size');
                                                                         }
                                                                         if (!externField && $extent === undefined) {
                                                                             $$parser.fail('Array ' + $id + ' needs a size',
                                                                                     $$s, $$i, 'E431',
                                                                                     'only a sizeless `extern array` or `extern struct` field may omit it');
                                                                         }
                                                                         $$.type = 'A';
                                                                         $$.elem = $desc;
                                                                         $$.name = $id;
                                                                         $$.at   = $nameStart;                 /* see VarDecl */
                                                                         $$.size = $extent;
                                                                         $$.words = $extent;                   /* an array's words ARE its count; a struct element
                                                                                                                    scales symbolically, in arrayAllocSize */
                                                                     }

# ------------------------------------------------------------------
#  Statement rule dispatch                                      
# ------------------------------------------------------------------
Statement   <-                                                        {
                                                                         var snippet = $$s.substr($$i);
                                                                         var cut     = find(snippet, "{;\r\n");
                                                                         var txt     = (cut >= 0 ? snippet.substr(0, cut)
                                                                                              : snippet);
                                                                         $$parser.emitMeta({ operator:';', type:undefined,
                                                                                            operands:[ txt, undefined, undefined ] });
                                                                     }
                (
                    { $lblStart = $$i; }
                    label:Identifier ':' _                            {
                                                                            $$parser.emitMeta({ operator:'<--', type:undefined,
                                                                                                operands:[ '@' + $label._, undefined, undefined ] });
                                                                            /* carry the source position so processBranches can
                                                                               name the `.impala` line if this label is a duplicate */
                                                                            var lbl = $$parser.metacode[$$parser.metacode.length - 1];
                                                                            lbl.labelSource = $$s;
                                                                            lbl.labelOffset = $$i;
                                                                            /* the 1.x `goto break;` early-exit idiom is the --legacy case */
                                                                            $$parser.checkReservedName($label._, 'label', $$s, $lblStart);
                                                                        }
                )*
                (   ';' _
                /   Assert
                /   Block
                /   Copy
                /   DoWhile
                /   Loop
                /   For
                /   Goto
                /   Return
                /   Break
                /   Continue
                /   If
                /   Switch
                /   While
                /   Destructure
                /   Expr ';' _                                        {
                                                                         if (metaSlot($$).winBase !== undefined) {     /* discarded struct-return value: free its window + base */
                                                                             $$parser.returnBack(metaSlot($$).base);
                                                                             $$parser.freeStructWindow($$);
                                                                         }
                                                                         $$parser.releaseMeta($$);
                                                                     }
                )

Expr        <-  Bitwise ('='_ r:Expr               { if (!$$parser.dry)
                                                       $$parser.assign($$, $$, $r, $$s, $$i); }
                )?

Bitwise     <-                                     { $first = undefined; }
                AddSub (op:BITWISE_OP _ r:AddSub   { if (!$$parser.dry) {
                                                       if ($first === undefined) $first = $op;
                                                       else if ($first !== $op)
                                                           $$parser.mixedBitwise($first, $op, $$s, $$i);
                                                       $$parser.binaryOp($op, $$, $r, $$s, $$i);
                                                     } }
                )*                                 { if (!$$parser.dry)
                                                       $$parser.stampBitwise($$, $first !== undefined); }

AddSub      <-  MulDiv (op:ADDSUB_OP _ r:MulDiv    { if (!$$parser.dry)
                                                       $$parser.binaryOp($op, $$, $r, $$s, $$i); }
                )*

MulDiv      <-  PrePost (op:MULDIV_OP _ r:PrePost  { if (!$$parser.dry)
                                                       $$parser.mulDivOp($op, $$, $r, $$s, $$i); }
                )*

PrePost     <-  (op:PREFIX_OP _
                / '('_ op:BASE_TYPE _               { $cdesc = $$parser.CASTS_TO_TYPES[$op]; }
                  ( POINTER _                       { $cdesc = 'p:' + $cdesc; $ccast = 'pointer'; }
                  )* ')'_
                / '('_ sid:Identifier               { $pdepth = 0; }   # named-type cast: (Name pointer ...) / (Fn)
                  ( POINTER _                       { $pdepth = $pdepth + 1; }
                  )* ')'_                           {
                                                      /* With no `pointer` this is only a cast when the name is a
                                                         FUNCTYPE, which is already a pointer and so needs no
                                                         modifier - a struct has no by-value cast, and anything else
                                                         is a plain parenthesized expression. Backing out (rather
                                                         than failing) lets Value parse `(x) + 1`; the test above is
                                                         a pure lookup, so there is no side effect to undo. */
                                                      if ($pdepth === 0) {
                                                          if (!$$parser.isFuncTypeAtom($sid)) return false;
                                                          $cdesc = 'F:' + $sid;
                                                          $ccast = 'funcptr';
                                                      } else {
                                                          if (!$$parser.isStructAtom($sid) && !$$parser.isFuncTypeAtom($sid))
                                                              $$parser.fail('Unknown type ' + $sid, $$s, $$i, 'E413');
                                                          $cdesc = $sid;
                                                          for (var _pk = 0; _pk < $pdepth; ++_pk) $cdesc = 'p:' + $cdesc;
                                                          $ccast = 'pointer';
                                                      }
                                                    }
                ) PrePost                           { if (!$$parser.dry) {
                                                       if ($ccast) {          /* a named/pointer cast; a bare BASE_TYPE cast has no $ccast */
                                                           $$parser.unaryOp($ccast, $$, $$s, $$i);
                                                           $$parser.setElem($$, $$parser.descTail($cdesc));
                                                       } else {
                                                           $$parser.unaryOp($op, $$, $$s, $$i);
                                                       }
                                                     } }
                / Value (FuncCall / Subscript / FieldAccess)*

# Two subscripts, never interchangeable: `[i]` strides one word and costs one instruction, `[[i]]`
# strides sizeof(element) and costs one more. Each is an error where the other is correct, so the
# spelling states the cost at the use site - the same job `->` does for a load. `[[` is tried first;
# there is no ambiguity with a nested `a[b[i]]` because no Expr can begin with `[`.
# `$idxAt` is captured after the bracket: the closing `]] _` / `] _` eats the trailing space, so the
# action's own `$$i` names whatever follows the subscript (an `=`, or the next declaration).
Subscript   <-  '[['_                              { $idxAt = $$i; }
                s:Expr ']]'_                       { if (!$$parser.dry) {
                                                       var sbs = metaSlot($$);
                                                       if (!$$parser.subscriptScales(sbs))
                                                           $$parser.fail('Scaled subscript on a one-word element',
                                                                   $$s, $$i, 'E205',
                                                                   '`[[ ]]` scales by the element size - this element is one word, so write `[ ]`');
                                                       $$parser.subscriptStruct($$, $s, $$s, $idxAt);
                                                     } }
                / '['_                             { $idxAt = $$i; }
                  s:Expr ']'_                      { if (!$$parser.dry) {
                                                       var sb = metaSlot($$);
                                                       if ($$parser.subscriptScales(sb))
                                                           $$parser.fail('Plain subscript on a struct element',
                                                                   $$s, $$i, 'E204',
                                                                   'this element is a struct, so the index scales - write `[[ ]]`');
                                                       if ((sb.place && sb.arrayOf) || (sb.type === 'p' && $$parser.isStructAtom(sb.elem)))
                                                           $$parser.subscriptStruct($$, $s, $$s, $idxAt);
                                                       else
                                                           $$parser.binaryOp('=[]', $$, $s, $$s, $idxAt);
                                                     } }

FieldAccess <-  '->'_ f:Identifier                 { if (!$$parser.dry)
                                                       $$parser.fieldAccess($$, $f, true, $$s, $$i); }
                / '.'_ f:Identifier                { if (!$$parser.dry)
                                                       $$parser.fieldAccess($$, $f, false, $$s, $$i); }

FuncCall    <-  '('_                               { if (!$$parser.dry) {
                                                       $$.count = 0;
                                                       /* how many leading output slots the callee expects (>1 = multi-return) */
                                                       var _c = metaSlot($$);
                                                       var _rs = 1;
                                                       if (_c.operator === ':=' && _c.operands[1]
                                                               && (_c.operands[1][0] === '&' || _c.operands[1][0] === '^')) {
                                                           var _e = $$parser.symbols.functions[_c.operands[1].substr(1)];
                                                           if (_e && _e.signature && _e.signature.returnWords !== undefined
                                                                   && _e.signature.returnWords > 1)
                                                               _rs = _e.signature.returnWords;   /* multi-scalar OR by-value struct return window */
                                                       } else if (_c.type === 'F' && $$parser.isFuncTypeAtom(_c.elem)) {
                                                           var _ft = $$parser.functypes[_c.elem];   /* indirect call through a named funcptr type */
                                                           if (_ft.returnWords > 1) _rs = _ft.returnWords;
                                                       }
                                                       $$.retSlots = _rs;
                                                       $$.words = 0;                            /* input words placed so far (struct args span >1) */
                                                       $$.base  = $$parser.borrowForCall();
                                                       for (var _os = 1; _os < _rs; ++_os)      /* reserve the extra output slots */
                                                           $$parser.claimSlot($$.base + _os);
                                                       $$.types = [];
                                                       $$.elems = [];

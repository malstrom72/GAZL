            if (p.type === 'A' && $$parser.isStructAtom(p.elem)) {   /* struct-element array -> a foldable local array place (base:offset, no ADRL) */
                $$parser.setPlace(x, 'local', '$' + name, [], undefined, p.elem, p.elem);

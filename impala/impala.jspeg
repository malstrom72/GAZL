        '=float',     noop,
        '=funcptr',   noop,
        '=int',       noop,
        '=pointer',   noop,

        '=*',         $$parser.dereference,
        '=&',         $$parser.reference,
        '=-',         $$parser.minus,
        '=~',         $$parser.not,
        '=abs',       $$parser.absFloor,
        '=itof',      $$parser.intToFloatConvert,
        '=ftoi',      $$parser.floatToIntConvert,
        '=floor',     $$parser.absFloor

# Ensure .gazl files are always treated as text (not binary)
# and force a text diff using a custom driver (handles files with NULs)
*.gazl text diff=gazl

# src/UnitTest.inc is generated by tools/UpdateUnitTest.nuxjs.js, which writes LF on every platform. Pin the eol, or
# core.autocrlf=true expects CRLF in the working copy and every Windows build leaves the file reported as modified
# with an empty diff.
src/UnitTest.inc text eol=lf

# Fuzz regression inputs are byte-exact; line-ending conversion would corrupt them (design/fuzzing.md).
tests/fuzz/textCrashes/* binary

// Call overhead, isolated: a 2-argument leaf helper invoked once per iteration with nothing else in the loop. This is
// the upper bound on what inlining can win - every instruction not spent on `mix` is spent on the CALL, the return,
// and the four window moves that marshal the arguments in and the result out. The JIT pays extra beyond the
// interpreter's dispatch: a CALL is a residency BARRIER, so the enclosing loop is disqualified from v2.2 loop
// residency and every live slot round-trips through the frame each iteration.
//
// A/B PAIR with leafinline.impala. Everything below this header comment must stay identical between the two apart
// from the `inline` keyword - the whole point of the pair is that the timing delta has exactly one cause. Both print
// the same checksum, so a drift that changes behaviour is caught; keep them in step by hand for one that does not.
//
// The checksum is the wrapped 32-bit accumulator: integer only, so it is bit-exact between the interpreter and the
// JIT, and identical for the inlined and out-of-line lowerings.
extern native printInt;

const int N = 20000000;

function mix(int a, int b)
returns int r
{
	r = a * 3 + b;
}

function main()
locals int i, int acc
{
	acc = 0;
	for (i = 0 to N) acc = mix(acc, i);
	printInt(acc);
}
